<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- resizeableActivity enables the multi-window (split-screen) experiments of topic 6. -->
    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:resizeableActivity="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.UpSpaFixtures">

        <activity
            android:name=".HomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".LoginActivity" android:exported="false" />
        <activity android:name=".RegistrationActivity" android:exported="false" />
        <activity android:name=".PasswordChangeActivity" android:exported="false" />
        <activity android:name=".SplitLoginUsernameActivity" android:exported="false" />
        <activity android:name=".SplitLoginPasswordActivity" android:exported="false" />
        <activity android:name=".WebViewLoginActivity" android:exported="false" />
        <activity android:name=".ComposeLoginActivity" android:exported="false" />
        <activity android:name=".CustomViewLoginActivity" android:exported="false" />
        <activity android:name=".NoAutofillActivity" android:exported="false" />
    </application>

</manifest>
