<?xml version="1.0" encoding="utf-8"?>
<!-- Multi-screen login, step 1: identifier only (no password on this screen). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/split_user_title"
        android:textSize="20sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/splitUsername"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/split_user_hint"
        android:inputType="text" />

    <Button
        android:id="@+id/splitNext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/split_next" />
</LinearLayout>
