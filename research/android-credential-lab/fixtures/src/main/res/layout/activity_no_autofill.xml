<?xml version="1.0" encoding="utf-8"?>
<!-- Autofill-disabled fixture (research topic 7): the root opts the whole subtree out, so a
     correct provider should receive no fillable structure for this screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAutofill="noExcludeDescendants"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/na_title"
        android:textSize="16sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/naUsername"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/login_user_hint"
        android:inputType="text" />

    <EditText
        android:id="@+id/naPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/login_password_hint"
        android:inputType="textPassword" />
</LinearLayout>
