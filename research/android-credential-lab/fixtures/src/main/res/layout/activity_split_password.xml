<?xml version="1.0" encoding="utf-8"?>
<!-- Multi-screen login, step 2: password only. Together with step 1 this exercises
     FillContext history / setClientState behavior (research topic 6). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/split_password_title"
        android:textSize="20sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/splitPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/split_password_hint"
        android:inputType="textPassword" />

    <Button
        android:id="@+id/splitSubmit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/split_submit" />
</LinearLayout>
