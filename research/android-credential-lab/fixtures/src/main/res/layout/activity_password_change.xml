<?xml version="1.0" encoding="utf-8"?>
<!-- Password change: current + new + confirm. Exercises the Tier 3 topology rule:
     current marker + new passwords => PASSWORD_CHANGE. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/pc_title"
        android:textSize="20sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/pcCurrentPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/pc_current_hint"
        android:inputType="textPassword" />

    <EditText
        android:id="@+id/pcNewPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/pc_new_hint"
        android:inputType="textPassword" />

    <EditText
        android:id="@+id/pcConfirmPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/pc_confirm_hint"
        android:inputType="textPassword" />

    <Button
        android:id="@+id/pcSubmit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/pc_submit" />
</LinearLayout>
