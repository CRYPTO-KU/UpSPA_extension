<?xml version="1.0" encoding="utf-8"?>
<!-- Capability declaration for the Credential Manager provider stub (API 34+).
     Only password credentials are declared; passkeys are out of scope for this track. -->
<credential-provider xmlns:android="http://schemas.android.com/apk/res/android">
    <capabilities>
        <capability name="android.credentials.TYPE_PASSWORD_CREDENTIAL" />
    </capabilities>
</credential-provider>
