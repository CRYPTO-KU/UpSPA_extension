<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Security audit (2026-08-22): this module requests NO <uses-permission> at all.
         In particular INTERNET is absent, so the research provider has no network
         exfiltration path by construction. The android:permission attributes on the two
         services below are binding restrictions (only the system holds them), not
         permissions requested by this app. -->

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.UpSpaResearch">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Secure authentication Activity, launched through the IntentSender attached to the
             locked FillResponse entry. Not exported: the PendingIntent carries our identity. -->
        <activity
            android:name=".AuthActivity"
            android:excludeFromRecents="true"
            android:exported="false" />

        <!-- Minimal Autofill service (platform floor: API 26). -->
        <service
            android:name=".UpSpaAutofillService"
            android:exported="true"
            android:label="@string/autofill_service_label"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service_config" />
        </service>

        <!-- Credential Manager provider stub (platform floor: API 34). Devices below 34 never
             bind this action, so the declaration is inert there. -->
        <service
            android:name=".UpSpaCredentialProviderService"
            android:exported="true"
            android:label="@string/credential_service_label"
            android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE"
            tools:targetApi="34">
            <intent-filter>
                <action android:name="android.service.credentials.CredentialProviderService" />
            </intent-filter>
            <meta-data
                android:name="android.credentials.provider"
                android:resource="@xml/credential_provider_capabilities" />
        </service>
    </application>

</manifest>
