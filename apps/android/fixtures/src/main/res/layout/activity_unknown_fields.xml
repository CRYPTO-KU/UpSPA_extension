<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/unknown_title"
            android:textSize="22sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp"
            android:text="@string/unknown_expectation" />

        <EditText
            android:id="@+id/preference_favourite_colour"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/unknown_favourite_colour"
            android:importantForAutofill="yes"
            android:inputType="text"
            tools:ignore="Autofill">

            <!-- Focus on launch, so the fill request is raised without a synthetic tap. -->
            <requestFocus />
        </EditText>

        <EditText
            android:id="@+id/preference_pet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/unknown_pet"
            android:importantForAutofill="yes"
            android:inputType="text"
            tools:ignore="Autofill" />

        <EditText
            android:id="@+id/preference_lucky_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/unknown_lucky_number"
            android:importantForAutofill="yes"
            android:inputType="number"
            tools:ignore="Autofill" />

        <Button
            android:id="@+id/fixture_submit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fixture_submit" />
    </LinearLayout>
</ScrollView>
